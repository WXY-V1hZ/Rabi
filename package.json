{
  "name": "rabi",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm --filter ./apps/web exec tsc -b --clean",
    "typecheck": "pnpm build:type && pnpm -r --if-present run typecheck",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint -c .oxlintrc.json --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm fmt && pnpm lint && pnpm typecheck",
    "prepare": "husky",
    "build:type": "pnpm --filter protocol build",
    "rabi": "pnpm --filter executor cli"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.18.0"
}
